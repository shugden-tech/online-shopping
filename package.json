{
  "name": "genzst",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "icons": "node scripts/make-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply genzst --local",
    "db:migrate:remote": "wrangler d1 migrations apply genzst --remote",
    "db:orders:local": "wrangler d1 execute genzst --local --command \"SELECT order_no, created_at, status, name, phone, total FROM orders ORDER BY id DESC LIMIT 20\"",
    "linkcheck": "node scripts/check-links.mjs",
    "budget": "node scripts/js-budget.mjs",
    "deploy": "astro build && wrangler deploy",
    "test:api": "node scripts/test-api.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:catalog": "node scripts/test-catalog.mjs",
    "test:delivery": "node scripts/test-delivery.mjs",
    "test:storefront": "node scripts/test-storefront.mjs",
    "test:admin-ui": "node scripts/test-admin-ui.mjs",
    "test:e2e": "node scripts/test-e2e-commerce.mjs && node scripts/test-e2e-browser.mjs",
    "import:catalog": "node scripts/import-catalog.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/preact": "^4.1.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@preact/signals-core": "^1.14.5",
    "astro": "^5.18.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.2"
  }
}
