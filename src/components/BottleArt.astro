---
// Data-driven perfume bottle: silhouette from `bottleShape`, liquid tint from the scent family,
// brand initial on a gold label. When the product has a real photo (`image`), that is shown instead.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  shape: string;
  family: string;
  initial: string;
  image?: ImageMetadata;
  /** Accessible name. Leave empty when the product name is printed next to the art. */
  label?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { shape, family, initial, image, label, sizes = "(min-width: 900px) 320px, 45vw", eager = false, class: cls } = Astro.props;
---
{image ? (
  <Image
    src={image}
    alt={label ?? ""}
    widths={[240, 480, 800]}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    class:list={["bottle-photo", cls]}
  />
) : (
  <svg
    class:list={["bottle", cls]}
    viewBox="0 0 200 280"
    style={`--tint:var(--fam-${family})`}
    role={label ? "img" : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : "true"}
    focusable="false"
  >
    <use href={`#gz-b-${shape}`} />
    <text x="100" y="196" text-anchor="middle" font-size="36">{initial}</text>
  </svg>
)}

<style is:global>
  .bottle-photo { width: 100%; height: 100%; object-fit: contain; }
</style>
