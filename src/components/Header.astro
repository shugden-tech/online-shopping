---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.png";
import Icon from "./Icon.astro";
import LangToggle from "./LangToggle.astro";
import settings from "../data/settings.json";
import { getDict, route, fill, type Locale } from "../i18n";
import { formatPrice } from "../lib/price";

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
  /** Kept for compatibility with older pages; the light header is never transparent. */
  overlay?: boolean;
  current?: string;
}
const { locale, alternates, current = "" } = Astro.props;
const tr = getDict(locale);
const s = tr.store;
const shop = route("shop", locale);
const links = [
  { key: "shop", href: shop, label: s.all },
  { key: "women", href: `${shop}?gender=women`, label: tr.genders.women },
  { key: "men", href: `${shop}?gender=men`, label: tr.genders.men },
  { key: "unisex", href: `${shop}?gender=unisex`, label: tr.genders.unisex },
  { key: "new", href: `${shop}?sort=newest`, label: s.newIn, badge: true },
  { key: "finder", href: route("finder", locale), label: tr.nav.finder },
  { key: "about", href: route("about", locale), label: tr.nav.about },
  { key: "help", href: route("help", locale), label: tr.nav.help },
];
const announce = fill(s.announce, { price: formatPrice(settings.delivery.freeThreshold, locale) });
---
<div class="ann" data-announce>
  <p>{announce}</p>
</div>

<header class="hdr" data-header>
  <div class="wrap hdr__top">
    <button
      class="hdr__icon hdr__burger" type="button" data-menu-toggle
      aria-expanded="false" aria-controls="mobile-menu"
      aria-label={tr.nav.menu} data-open-label={tr.nav.menu} data-close-label={tr.nav.close}
    >
      <span class="hdr__burger-lines" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <a class="hdr__brand" href={route("home", locale)} aria-label={tr.nav.home}>
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} loading="eager" class="hdr__logo" />
      <span class="hdr__word" aria-hidden="true">genzst</span>
    </a>

    <form class="hdr__search" action={shop} method="get" role="search">
      <Icon name="search" size={18} />
      <label class="sr-only" for="hdr-q">{tr.nav.search}</label>
      <input id="hdr-q" name="q" type="search" placeholder={s.searchPlaceholder} autocomplete="off" enterkeyhint="search" />
    </form>

    <div class="hdr__tools">
      <div class="hdr__lang"><LangToggle locale={locale} alternates={alternates} /></div>
      <button class="hdr__cart" type="button" data-cart-open data-label={tr.nav.cartCount} aria-label={tr.nav.cart} aria-haspopup="dialog">
        <Icon name="bag" size={22} />
        <span class="hdr__cart-label">{tr.nav.cart}</span>
        <span class="hdr__badge" data-cart-count data-empty aria-hidden="true">0</span>
      </button>
    </div>
  </div>

  <nav class="hdr__nav" aria-label={tr.nav.main}>
    <div class="wrap hdr__nav-in">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? "page" : undefined}>
          {l.label}{l.badge && <span class="hdr__new">NEW</span>}
        </a>
      ))}
    </div>
  </nav>
</header>

<div class="mmenu" id="mobile-menu" inert>
  <nav class="mmenu__nav" aria-label={tr.nav.main}>
    {links.map((l, i) => (
      <a href={l.href} style={`--i:${i}`} aria-current={current === l.key ? "page" : undefined}>
        <span class="mmenu__label">{l.label}</span>
        <Icon name="arrow" size={16} />
      </a>
    ))}
  </nav>
  <div class="mmenu__foot" style={`--i:${links.length}`}>
    <LangToggle locale={locale} alternates={alternates} />
  </div>
</div>

<style>
  .ann { position: relative; z-index: 61; background: var(--gold); color: #fff; text-align: center; font-size: 12.5px; line-height: 1.4; padding: 9px var(--gutter); }

  .hdr { position: sticky; top: 0; z-index: 60; background: #fff; transition: box-shadow .3s; }
  .hdr:global([data-scrolled]) { box-shadow: 0 6px 24px rgba(0, 0, 0, .07); }

  .hdr__top { display: flex; align-items: center; gap: 24px; height: 72px; }
  .hdr__brand { display: inline-flex; align-items: center; gap: 10px; flex: none; min-height: 44px; }
  .hdr__logo { width: 40px; height: 40px; border-radius: 50%; background: #070707; }
  .hdr__word { font-family: var(--font-head); font-weight: 600; font-size: 28px; letter-spacing: .16em; line-height: 1; padding-bottom: 3px; }

  .hdr__search {
    flex: 1; max-width: 560px; margin-inline: auto; display: flex; align-items: center; gap: 10px;
    height: 44px; padding: 0 18px; border-radius: 999px; background: var(--soft); border: 1px solid transparent;
    color: var(--text-dim); transition: border-color .2s, background-color .2s;
  }
  .hdr__search:focus-within { background: #fff; border-color: var(--black); }
  .hdr__search input { flex: 1; min-width: 0; border: 0; background: transparent; outline: 0; font-size: 15px; color: var(--text); }
  .hdr__search input::placeholder { color: #8f8c86; }
  .hdr__search input::-webkit-search-cancel-button { display: none; }

  .hdr__tools { display: flex; align-items: center; gap: 8px; flex: none; }
  .hdr__lang { margin-inline: 4px; }
  .hdr__cart {
    position: relative; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px 0 10px;
    border-radius: 999px; transition: background-color .2s;
  }
  .hdr__cart:hover { background: var(--soft); }
  .hdr__cart-label { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .hdr__badge {
    min-width: 20px; height: 20px; padding: 0 5px; display: grid; place-items: center; border-radius: 10px;
    background: var(--black); color: #fff; font-size: 11px; font-weight: 600; line-height: 1;
    transition: opacity .3s, transform .3s var(--ease-out);
  }
  .hdr__badge[data-empty] { opacity: 0; transform: scale(.4); }
  .hdr__cart:global(.is-pulse) .hdr__badge { animation: gz-pop .6s var(--ease-out); }
  @keyframes gz-pop { 40% { transform: scale(1.35); } }

  .hdr__nav { background: var(--black); }
  .hdr__nav-in { display: flex; align-items: center; gap: 4px; height: 44px; overflow-x: auto; scrollbar-width: none; }
  .hdr__nav a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px; border-radius: 4px; white-space: nowrap;
    color: #fff; font-size: 13px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; transition: background-color .2s;
  }
  .hdr__nav a:first-child { margin-left: -14px; }
  .hdr__nav a:hover, .hdr__nav a[aria-current] { background: rgba(255, 255, 255, .14); }
  .hdr__new { font-size: 9px; font-weight: 700; letter-spacing: .06em; padding: 2px 5px; border-radius: 3px; background: #c9a24f; color: #141414; }

  .hdr__icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; }
  .hdr__burger { display: none; margin-left: -10px; }
  .hdr__burger-lines { position: relative; width: 22px; height: 14px; display: block; }
  .hdr__burger-lines i { position: absolute; left: 0; height: 1.6px; background: currentColor; border-radius: 1px; transition: transform .35s var(--ease-out), top .35s var(--ease-out), opacity .2s; }
  .hdr__burger-lines i:nth-child(1) { top: 0; right: 0; }
  .hdr__burger-lines i:nth-child(2) { top: 6px; right: 0; }
  .hdr__burger-lines i:nth-child(3) { top: 12px; right: 9px; }
  .hdr__burger[aria-expanded="true"] i:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .hdr__burger[aria-expanded="true"] i:nth-child(2) { opacity: 0; }
  .hdr__burger[aria-expanded="true"] i:nth-child(3) { top: 6px; right: 0; transform: rotate(-45deg); }

  /* ---------- slide-in mobile menu ---------- */
  .mmenu {
    position: fixed; top: 0; bottom: 0; left: 0; z-index: 70; width: min(320px, 86vw); display: none; flex-direction: column; justify-content: space-between;
    padding: 72px 20px 24px; background: #fff; box-shadow: 0 0 60px rgba(0, 0, 0, .2);
    transform: translateX(-102%); visibility: hidden;
    transition: transform .35s var(--ease-out), visibility 0s linear .35s;
    overflow-y: auto;
  }
  :global(html[data-menu-open]) .mmenu { transform: none; visibility: visible; transition-delay: 0s; }
  :global(html[data-menu-open]) { overflow: hidden; }
  :global(html[data-menu-open]) .hdr__burger { position: relative; z-index: 80; }
  .mmenu__nav { display: grid; }
  .mmenu__nav a {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 52px; padding: 0 4px;
    border-bottom: 1px solid var(--line-soft); font-size: 15px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
  }
  .mmenu__nav a :global(svg) { color: var(--text-dim); }
  .mmenu__nav a[aria-current] { color: var(--gold); }
  .mmenu__foot { margin-top: 24px; }

  @media (max-width: 900px) {
    .hdr__top { flex-wrap: wrap; height: auto; gap: 4px 8px; padding-block: 8px 10px; }
    .hdr__burger { display: inline-flex; }
    .hdr__brand { margin-right: auto; }
    .hdr__word { font-size: 22px; }
    .hdr__logo { width: 34px; height: 34px; }
    .hdr__search { order: 5; flex-basis: 100%; max-width: none; height: 42px; }
    .hdr__lang, .hdr__cart-label { display: none; }
    .hdr__cart { padding: 0 10px; }
    .hdr__badge { position: absolute; top: 2px; right: 0; }
    .hdr__nav { display: none; }
    .mmenu { display: flex; }
  }
</style>
