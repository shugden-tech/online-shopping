---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.png";
import Icon from "./Icon.astro";
import LangToggle from "./LangToggle.astro";
import { getDict, route, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
  /** Transparent over a hero until the page is scrolled 40px. */
  overlay?: boolean;
  current?: string;
}
const { locale, alternates, overlay = false, current = "" } = Astro.props;
const tr = getDict(locale);
const links = [
  { key: "shop", href: route("shop", locale), label: tr.nav.shop },
  { key: "finder", href: route("finder", locale), label: tr.nav.finder },
  { key: "about", href: route("about", locale), label: tr.nav.about },
];
const menuLinks = [...links, { key: "help", href: route("help", locale), label: tr.nav.help }];
---
<header class="hdr" data-header data-overlay={overlay ? "" : undefined}>
  <div class="wrap hdr__in">
    <a class="hdr__brand" href={route("home", locale)} aria-label={tr.nav.home}>
      <Image src={logo} alt="" width={44} height={44} densities={[1, 2]} loading="eager" class="hdr__logo" />
      <span class="hdr__word" aria-hidden="true">genzst</span>
    </a>

    <nav class="hdr__nav" aria-label={tr.nav.main}>
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="hdr__tools">
      <a class="hdr__icon hdr__search" href={`${route("shop", locale)}#search`} aria-label={tr.nav.search}>
        <Icon name="search" />
      </a>
      <div class="hdr__lang"><LangToggle locale={locale} alternates={alternates} /></div>
      <button class="hdr__icon hdr__cart" type="button" data-cart-open data-label={tr.nav.cartCount} aria-label={tr.nav.cart} aria-haspopup="dialog">
        <Icon name="bag" />
        <span class="hdr__badge" data-cart-count data-empty aria-hidden="true">0</span>
      </button>
      <button
        class="hdr__icon hdr__burger" type="button" data-menu-toggle
        aria-expanded="false" aria-controls="mobile-menu"
        aria-label={tr.nav.menu} data-open-label={tr.nav.menu} data-close-label={tr.nav.close}
      >
        <span class="hdr__burger-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="mmenu" id="mobile-menu" inert>
  <nav class="mmenu__nav" aria-label={tr.nav.main}>
    {menuLinks.map((l, i) => (
      <a href={l.href} style={`--i:${i}`} aria-current={current === l.key ? "page" : undefined}>
        <span class="mmenu__num" aria-hidden="true">0{i + 1}</span>
        <span class="mmenu__label">{l.label}</span>
      </a>
    ))}
  </nav>
  <div class="mmenu__foot" style={`--i:${menuLinks.length}`}>
    <LangToggle locale={locale} alternates={alternates} />
    <a class="mmenu__search" href={`${route("shop", locale)}#search`}>
      <Icon name="search" size={18} /> {tr.nav.search}
    </a>
  </div>
</div>

<style>
  .hdr {
    position: fixed; inset: 0 0 auto 0; z-index: 60; height: var(--header-h);
    background: var(--ink); border-bottom: 1px solid var(--line);
    transition: background-color .45s var(--ease-sine), border-color .45s var(--ease-sine);
  }
  .hdr[data-overlay]:not([data-scrolled]) { background: transparent; border-bottom-color: transparent; }
  :global(html[data-menu-open]) .hdr { background: var(--ink); border-bottom-color: transparent; }

  .hdr__in { height: 100%; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; }

  .hdr__brand { display: inline-flex; align-items: center; gap: 10px; justify-self: start; min-height: 44px; }
  .hdr__logo { width: 44px; height: 44px; }
  .hdr__word { font-family: var(--font-head); font-weight: 500; font-size: 24px; letter-spacing: .14em; line-height: 1; padding-bottom: 3px; }

  .hdr__nav { display: flex; gap: clamp(20px, 3vw, 44px); }
  .hdr__nav a {
    position: relative; display: inline-flex; align-items: center; min-height: 44px;
    font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: .22em;
    color: var(--text); transition: color .3s;
  }
  :global(:lang(mn)) .hdr__nav a { letter-spacing: .14em; }
  .hdr__nav a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 8px; height: 1px; background: var(--gold);
    transform: scaleX(0); transform-origin: left; transition: transform .45s var(--ease-out);
  }
  .hdr__nav a:hover, .hdr__nav a[aria-current] { color: var(--gold-soft); }
  .hdr__nav a:hover::after, .hdr__nav a[aria-current]::after { transform: scaleX(1); }

  .hdr__tools { display: flex; align-items: center; justify-self: end; gap: 2px; }
  .hdr__icon {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; color: var(--text); transition: color .3s;
  }
  .hdr__icon:hover { color: var(--gold-soft); }
  .hdr__lang { margin-inline: 6px; }

  /* the badge is absolutely positioned and always present, so it can never shift the layout */
  .hdr__badge {
    position: absolute; top: 5px; right: 2px; min-width: 17px; height: 17px; padding: 0 4px;
    display: grid; place-items: center; border-radius: 9px;
    background: var(--gold); color: #0b0906; font-size: 10px; font-weight: 500; line-height: 1;
    transition: opacity .3s, transform .3s var(--ease-out);
  }
  .hdr__badge[data-empty] { opacity: 0; transform: scale(.4); }
  .hdr__cart::before {
    content: ""; position: absolute; inset: 4px; border-radius: 50%; border: 1px solid var(--gold); opacity: 0; pointer-events: none;
  }
  .hdr__cart:global(.is-pulse)::before { animation: gz-pulse .9s var(--ease-out); }
  @keyframes gz-pulse {
    0% { opacity: .9; transform: scale(.6); box-shadow: 0 0 0 0 rgba(204, 158, 72, .5); }
    100% { opacity: 0; transform: scale(1.5); box-shadow: 0 0 18px 4px rgba(204, 158, 72, 0); }
  }

  .hdr__burger { display: none; }
  .hdr__burger-lines { position: relative; width: 22px; height: 10px; display: block; }
  .hdr__burger-lines i { position: absolute; left: 0; right: 0; height: 1px; background: currentColor; transition: transform .45s var(--ease-out), top .45s var(--ease-out); }
  .hdr__burger-lines i:first-child { top: 0; }
  .hdr__burger-lines i:last-child { top: 9px; }
  .hdr__burger[aria-expanded="true"] i:first-child { top: 4.500px; transform: rotate(45deg); }
  .hdr__burger[aria-expanded="true"] i:last-child { top: 4.500px; transform: rotate(-45deg); }

  /* ---------- full-screen mobile menu ---------- */
  .mmenu {
    position: fixed; inset: 0; z-index: 55; display: none; flex-direction: column; justify-content: space-between;
    padding: calc(var(--header-h) + 32px) var(--gutter) 32px;
    background: var(--ink);
    background-image: radial-gradient(120% 60% at 50% 0%, rgba(204, 158, 72, .12), transparent 70%);
    opacity: 0; visibility: hidden;
    transition: opacity .45s var(--ease-sine), visibility 0s linear .45s;
    overflow-y: auto;
  }
  :global(html[data-menu-open]) .mmenu { opacity: 1; visibility: visible; transition-delay: 0s; }
  :global(html[data-menu-open]) { overflow: hidden; }

  .mmenu__nav { display: grid; }
  .mmenu__nav a {
    display: flex; align-items: baseline; gap: 18px; padding: 16px 0; border-bottom: 1px solid var(--line);
    opacity: 0; transform: translateY(12px);
    transition: opacity .65s var(--ease-sine), transform .65s var(--ease-sine), color .3s;
  }
  .mmenu__num { font-size: 11px; font-weight: 500; letter-spacing: .2em; color: var(--gold); }
  .mmenu__label { font-family: var(--font-head); font-weight: 300; font-size: clamp(32px, 9vw, 44px); line-height: 1.15; }
  .mmenu__nav a[aria-current] .mmenu__label { color: var(--gold-soft); font-style: italic; }
  .mmenu__foot {
    display: flex; align-items: center; justify-content: space-between; margin-top: 32px;
    opacity: 0; transition: opacity .65s var(--ease-sine);
  }
  .mmenu__search { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: 12px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--text-dim); }
  :global(html[data-menu-open]) .mmenu__nav a,
  :global(html[data-menu-open]) .mmenu__foot { opacity: 1; transform: none; transition-delay: calc(120ms + var(--i) * 80ms); }

  @media (max-width: 900px) {
    .hdr__in { grid-template-columns: 1fr auto; }
    .hdr__nav, .hdr__lang, .hdr__search { display: none; }
    .hdr__burger { display: inline-flex; }
    .mmenu { display: flex; }
    .hdr__logo { width: 38px; height: 38px; }
    .hdr__word { font-size: 21px; }
  }
</style>
