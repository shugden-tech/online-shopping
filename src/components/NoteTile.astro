---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  name: string;
  /** The same name in the other language, shown on hover / focus. */
  alt: string;
  altLang: string;
  href: string;
  index: number;
  wide?: boolean;
}
const { image, name, alt, altLang, href, index, wide = false } = Astro.props;
---
<a class:list={["ntile", { "ntile--wide": wide }]} href={href} data-reveal style={`--delay:${(index % 4) * 80}ms`}>
  <Image
    src={image}
    alt=""
    widths={[240, 360, 480, 636]}
    sizes={wide ? "(min-width: 900px) 50vw, 100vw" : "(min-width: 900px) 25vw, 50vw"}
    loading="lazy"
    quality={62}
  />
  <span class="ntile__label">
    <span class="ntile__name">{name}</span>
    <span class="ntile__alt" lang={altLang}>{alt}</span>
  </span>
</a>

<style>
  .ntile { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--ink-2); isolation: isolate; }
  .ntile--wide { grid-column: span 2; aspect-ratio: 8 / 5; }
  .ntile :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.2s var(--ease-out), filter .65s var(--ease-sine);
    filter: brightness(.82);
  }
  .ntile:hover :global(img), .ntile:focus-visible :global(img) { transform: scale(1.04); filter: brightness(1); }
  .ntile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(7, 7, 7, .38) 64%, rgba(7, 7, 7, .92)); pointer-events: none; } /* keeps labels readable over bright photos (white flowers, saffron) */
  .ntile:focus-visible { outline-offset: -3px; }

  .ntile__label { position: absolute; left: 16px; right: 16px; bottom: 14px; z-index: 1; display: grid; gap: 2px; }
  .ntile__name { font-family: var(--font-head); font-weight: 300; font-size: clamp(22px, 1.6vw + 14px, 34px); line-height: 1.1; text-shadow: 0 1px 14px rgba(7, 7, 7, .55); }
  .ntile__alt {
    font-size: 10px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: var(--gold);
    opacity: 0; transform: translateY(6px); transition: opacity .65s var(--ease-sine), transform .65s var(--ease-sine);
  }
  .ntile:hover .ntile__alt, .ntile:focus-visible .ntile__alt { opacity: 1; transform: none; }
  @media (hover: none) { .ntile__alt { opacity: 1; transform: none; } }
</style>
