---
import BottleArt from "./BottleArt.astro";
import { getDict, productPath, fill, type Locale } from "../i18n";
import { formatPrice } from "../lib/price";
import { cartBase, defaultSize, initialOf, isSoldOut, photosOf, sortedSizes, type Product } from "../lib/products";

interface Props {
  product: Product;
  locale: Locale;
  /** Heading level for the product name. */
  level?: 2 | 3;
  eager?: boolean;
  class?: string;
}
const { product: p, locale, level = 3, eager = false, class: cls } = Astro.props;
const tr = getDict(locale);
const href = productPath(locale, p.slug);
const sizes = sortedSizes(p);
const start = defaultSize(p);
const soldOut = isSoldOut(p);
const base = await cartBase(p);
const H = `h${level}` as "h2" | "h3";
// The owner's own photo (`image`) wins; otherwise the linked remote photos (front first, then back).
const photos = p.image ? [] : photosOf(p, 800);
const [main, alt] = photos;
const altText = (kind: "front" | "back") => `${p.brand} ${p.name} — ${kind === "front" ? tr.common.photoFront : tr.common.photoBack}`;
const imgSizes = "(min-width: 1100px) 280px, (min-width: 700px) 30vw, 46vw";
const addLabel = (ml: number) => `${p.name}: ${fill(tr.common.addSize, { ml })}`;
---
<article class:list={["pcard", cls]} data-card data-slug={p.slug} style={`--tint:var(--fam-${p.family})`}>
  <a class="pcard__media" href={href} tabindex="-1" aria-hidden="true">
    {main ? (
      <span class="pcard__photos" data-photos>
        <span class="pcard__ph" aria-hidden="true"><BottleArt shape={p.bottleShape} family={p.family} initial={initialOf(p)} /></span>
        <img
          class="pcard__img pcard__img--main" src={main.src} srcset={main.srcset} sizes={main.srcset ? imgSizes : undefined}
          alt={altText(main.kind)} width="800" height="800" decoding="async"
          loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined}
          onerror="this.parentNode.dataset.main='err'"
        />
        {alt && (
          <img
            class="pcard__img pcard__img--alt" src={alt.src} srcset={alt.srcset} sizes={alt.srcset ? imgSizes : undefined}
            alt={altText(alt.kind)} width="800" height="800" decoding="async" loading="lazy"
            onload="this.dataset.ok=''" onerror="this.parentNode.dataset.alt='err'"
          />
        )}
      </span>
    ) : (
      <BottleArt shape={p.bottleShape} family={p.family} initial={initialOf(p)} image={p.image} eager={eager} />
    )}
  </a>
  {p.isNew && !soldOut && <span class="pcard__flag">{tr.common.new}</span>}
  {soldOut && <span class="pcard__flag pcard__flag--out">{tr.common.soldOut}</span>}

  <div class="pcard__body">
    <p class="pcard__brand">{p.brand}</p>
    <H class="pcard__name"><a href={href}>{p.name}</a></H>
    <p class="pcard__meta">
      <span class="pcard__fam">{tr.families[p.family]}</span>
      <span aria-hidden="true">·</span>
      <span>{p.concentration}</span>
    </p>

    <p class="pcard__price" data-card-price aria-live="polite">{formatPrice(start.price, locale)}</p>

    <div class="pcard__sizes" role="group" aria-label={tr.common.size}>
      {sizes.map((s) => (
        <button
          type="button"
          class="pcard__size"
          data-size-chip
          data-ml={s.ml}
          data-price={s.price}
          data-price-label={formatPrice(s.price, locale)}
          aria-pressed={s.ml === start.ml && s.inStock ? "true" : "false"}
          disabled={!s.inStock}
        >
          {s.ml}<small>{" "}{tr.common.ml}</small>{!s.inStock && <span class="sr-only"> — {tr.common.soldOut}</span>}
        </button>
      ))}
    </div>

    <div class="pcard__foot">
      <button
        type="button"
        class="pcard__add"
        data-add
        data-item={JSON.stringify(base)}
        data-ml={start.ml}
        data-price={start.price}
        data-label-tpl={addLabel(0).replace(" 0 ", " {ml} ")}
        aria-label={addLabel(start.ml)}
        disabled={soldOut}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 12.5H6L5 8z"/><path d="M9 8V6.5a3 3 0 016 0V8"/></svg>
        <span>{soldOut ? tr.common.soldOut : tr.common.add}</span>
      </button>
    </div>
  </div>
</article>

<style>
  .pcard { position: relative; display: flex; flex-direction: column; min-width: 0; }

  .pcard__media {
    position: relative; display: grid; place-items: center; aspect-ratio: 1; padding: 10% 26% 6%;
    border-radius: 8px; overflow: hidden;
    background:
      radial-gradient(60% 50% at 50% 62%, color-mix(in srgb, var(--tint) 22%, transparent), transparent 100%),
      linear-gradient(180deg, #faf9f7, #f1efec);
  }
  .pcard__media :global(.bottle) { transition: transform .7s var(--ease-out); will-change: transform; }
  .pcard:hover .pcard__media :global(.bottle) { transform: translateY(-6px) scale(1.04) rotate(-2deg); }
  .pcard__media :global(.bottle-photo) { position: absolute; inset: 0; object-fit: cover; }

  /* Remote photos: front and back stacked in one fixed box, so hovering never moves the layout. */
  .pcard__photos { position: absolute; inset: 0; display: block; background: #fff; }
  .pcard__img, .pcard__ph {
    position: absolute; inset: 6%; width: 88%; height: 88%; object-fit: contain;
    transition: opacity .25s ease;
  }
  .pcard__ph { display: grid; place-items: center; padding: 4% 20% 0; visibility: hidden; }
  .pcard__img--alt { opacity: 0; }
  /* Front failed: show the back instead (if it loaded), else the illustrated bottle. */
  [data-main="err"] .pcard__img--main { display: none; }
  [data-main="err"] .pcard__img--alt[data-ok] { opacity: 1; }
  [data-main="err"]:not(:has(.pcard__img--alt[data-ok])) .pcard__ph { visibility: visible; }
  [data-alt="err"] .pcard__img--alt { display: none; }

  /* Crossfade to the back photo: pointer hover on devices that hover, or keyboard focus on the card link.
     Only when the back photo actually loaded, so a missing/broken one leaves the front in place. */
  @media (hover: hover) and (pointer: fine) {
    .pcard:hover [data-photos]:not([data-main="err"]):has(.pcard__img--alt[data-ok]) .pcard__img--main { opacity: 0; }
    .pcard:hover [data-photos]:not([data-main="err"]) .pcard__img--alt[data-ok] { opacity: 1; }
  }
  .pcard:has(.pcard__name a:focus-visible) [data-photos]:not([data-main="err"]):has(.pcard__img--alt[data-ok]) .pcard__img--main { opacity: 0; }
  .pcard:has(.pcard__name a:focus-visible) [data-photos]:not([data-main="err"]) .pcard__img--alt[data-ok] { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .pcard__img, .pcard__ph { transition: none; }
  }

  .pcard__flag {
    position: absolute; top: 10px; left: 10px; z-index: 1; padding: 3px 8px; border-radius: 3px;
    background: var(--gold); color: #fff;
    font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; line-height: 1.4;
  }
  .pcard__flag--out { background: #8f8c86; }

  .pcard__body { display: flex; flex-direction: column; flex: 1; padding-top: 14px; }
  .pcard__brand {
    font-size: 11.5px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--text-dim); line-height: 1.5;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .pcard__name { font-family: var(--font-sans); font-weight: 600; font-size: 15.5px; line-height: 1.3; margin-top: 2px; }
  .pcard__name a { display: block; transition: color .2s; }
  .pcard__name a:hover { color: var(--gold); }
  .pcard__meta { display: flex; align-items: center; gap: 7px; margin-top: 4px; font-size: 12.5px; color: var(--text-dim); line-height: 1.4; }
  .pcard__fam { display: inline-flex; align-items: center; gap: 6px; }
  .pcard__fam::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--tint); }

  .pcard__price { margin-top: 8px; font-size: 16px; font-weight: 700; font-variant-numeric: tabular-nums; }

  .pcard__sizes { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 10px; }
  .pcard__size {
    position: relative; flex: 1; max-width: 64px; min-height: 36px; display: inline-flex; align-items: center; justify-content: center; gap: 2px;
    border: 1px solid var(--line); border-radius: 4px; background: #fff;
    font-size: 13px; font-weight: 500; color: var(--text); transition: border-color .2s, color .2s, background-color .2s;
  }
  .pcard__size::before { content: ""; position: absolute; inset: -4px 0; } /* 44px tap height */
  .pcard__size small { font-size: 11px; font-weight: 400; color: inherit; opacity: .75; }
  .pcard__size:hover:not(:disabled) { border-color: var(--black); }
  .pcard__size[aria-pressed="true"] { border-color: var(--black); background: var(--black); color: #fff; }
  .pcard__size:disabled { color: #b0ada7; text-decoration: line-through; cursor: not-allowed; border-style: dashed; }

  .pcard__foot { margin-top: 12px; }
  .pcard__add {
    width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 12px;
    border-radius: 6px; background: var(--black); color: #fff;
    font-size: 12.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    transition: background-color .2s, transform .15s;
  }
  .pcard__add:hover:not(:disabled) { background: #3a3a3a; }
  .pcard__add:active:not(:disabled) { transform: scale(.98); }
  .pcard__add:disabled { background: #e4e2de; color: #8f8c86; cursor: not-allowed; }
  .pcard__add:disabled svg { display: none; }

  @media (max-width: 480px) {
    .pcard__name { font-size: 14px; }
    .pcard__size { min-width: 0; padding: 0 2px; }
    .pcard__add { font-size: 11.5px; letter-spacing: .04em; }
    .pcard__add svg { display: none; }
  }
</style>
