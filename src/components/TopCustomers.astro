---
import demo from "../data/demo-community.json";
import { getDict, type Locale } from "../i18n";
import { formatPrice } from "../lib/price";

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getDict(locale).community;

const periods = [
  { id: "p7", label: c.p7 },
  { id: "p30", label: c.p30 },
  { id: "all", label: c.all },
] as const;
const DEFAULT = "all";

type Entry = { name: string; total: number };
/** Line chart geometry (SVG user units). */
const W = 720, H = 280, PX = 56, PT = 44, PB = 64;
const MAX_POINTS = 5;

/** Left-to-right slots: Top 1 in the middle, Top 2 to its right, Top 3 to its left, then Top 4 and Top 5 outside. */
const SLOT_ORDER = [5, 3, 1, 2, 4];

/** Points for the top entries, placed by slot. The highest amount sits at the top of the plot. */
const points = (list: Entry[]) => {
  const top = list.slice(0, MAX_POINTS);
  const max = Math.max(...top.map((e) => e.total), 1);
  const ranks = SLOT_ORDER.filter((r) => r <= top.length);
  const n = ranks.length;
  const span = W - PX * 2;
  return ranks.map((rank, slot) => {
    const e = top[rank - 1]!;
    return {
      rank,
      e,
      x: n > 1 ? PX + (slot * span) / (n - 1) : W / 2,
      y: PT + (H - PT - PB) * (1 - e.total / max),
    };
  });
};
const shortName = (name: string) => (name.length > 16 ? name.slice(0, 15) + "…" : name);
const gridRows = [0, 1, 2, 3];
---
<section class="wrap top3" aria-labelledby="top3-title" data-community>
  <div class="top3__panel">
    <header class="top3__head">
      <div class="top3__titles">
        <div class="top3__row">
          <h2 class="top3__title" id="top3-title">{c.topTitle}</h2>
          <span class="pill">{c.demo}</span>
        </div>
        <p class="top3__sub">{c.topSub}</p>
      </div>
      <div class="seg" role="tablist" aria-label={c.topTitle}>
        {periods.map((p) => (
          <button
            type="button" role="tab" id={`top3-tab-${p.id}`} aria-controls={`top3-panel-${p.id}`}
            aria-selected={p.id === DEFAULT ? "true" : "false"} tabindex={p.id === DEFAULT ? 0 : -1}
          >{p.label}</button>
        ))}
      </div>
    </header>

    {periods.map((p) => {
      const pts = points(demo.leaderboard[p.id]);
      const line = pts.map((q) => `${q.x.toFixed(1)},${q.y.toFixed(1)}`).join(" ");
      const area = pts.length
        ? `${pts[0]!.x.toFixed(1)},${H - PB} ${line} ${pts[pts.length - 1]!.x.toFixed(1)},${H - PB}`
        : "";
      return (
        <div class="chart" role="tabpanel" id={`top3-panel-${p.id}`} aria-labelledby={`top3-tab-${p.id}`} hidden={p.id !== DEFAULT}>
          <svg class="chart__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={c.topTitle}>
            {gridRows.map((g) => {
              const y = PT + ((H - PT - PB) * g) / 3;
              return <line class="chart__grid" x1={PX} x2={W - PX} y1={y} y2={y} />;
            })}
            <line class="chart__axis" x1={PX} x2={W - PX} y1={H - PB} y2={H - PB} />
            {pts.length > 0 && <polygon class="chart__area" points={area} />}
            {pts.length > 1 && <polyline class="chart__line" points={line} />}
            {pts.map((q) => (
              <g class={`chart__point chart__point--${q.rank}`}>
                <circle cx={q.x} cy={q.y} r={q.rank === 1 ? 7 : 5.5} />
                <text class="chart__value" x={q.x} y={q.y - 14} text-anchor="middle">{shortName(q.e.name)}</text>
                <text class="chart__rank" x={q.x} y={H - PB + 24} text-anchor="middle">Top {q.rank}</text>
                <text class="chart__name" x={q.x} y={H - PB + 44} text-anchor="middle">{formatPrice(q.e.total, locale)}</text>
              </g>
            ))}
          </svg>
          <ol class="sr-only">
            {pts.map((q) => <li>{q.rank}. {q.e.name}, {formatPrice(q.e.total, locale)}</li>)}
          </ol>
        </div>
      );
    })}
  </div>
</section>

<script>
  import "../scripts/community";
</script>

<style>
  .top3 { padding-top: clamp(44px, 6vw, 72px); }
  .top3__panel {
    background: var(--ink-2);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: clamp(20px, 3vw, 32px);
  }
  .top3__head {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 16px 24px; margin-bottom: 24px;
  }
  .top3__titles { min-width: 0; }
  .top3__row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .top3__title { margin: 0; font-size: clamp(22px, 2.6vw, 30px); font-weight: 700; line-height: 1.2; color: var(--text); }
  .top3__sub { margin: 6px 0 0; color: var(--text-dim); font-size: 14px; }
  .pill {
    display: inline-block; padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px;
    font-size: 11px; letter-spacing: .04em; color: var(--text-dim); white-space: nowrap;
  }

  .seg {
    display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: var(--soft); border-radius: 999px;
  }
  .seg [role="tab"] {
    appearance: none; border: 0; background: transparent; color: var(--text-dim); font: inherit;
    font-size: 13px; font-weight: 600; padding: 8px 14px; border-radius: 999px; cursor: pointer;
    transition: color .2s, background-color .2s;
  }
  .seg [role="tab"]:hover { color: var(--text); }
  .seg [role="tab"]:focus-visible { outline: 2px solid var(--black); outline-offset: 2px; }
  .seg [role="tab"][aria-selected="true"] { background: var(--black); color: var(--on-accent); }

  /* ---- line chart ---- */
  .chart[hidden] { display: none; }
  .chart { animation: rise .45s ease-out both; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .chart__svg { display: block; width: 100%; height: auto; max-width: 760px; margin-inline: auto; overflow: visible; }
  .chart__grid { stroke: var(--line-soft); stroke-width: 1; stroke-dasharray: 4 5; }
  .chart__axis { stroke: var(--line); stroke-width: 1.2; }
  .chart__area { fill: var(--gold); opacity: .08; }
  .chart__line { fill: none; stroke: var(--black); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
  .chart__point circle { fill: var(--ink-2); stroke: var(--black); stroke-width: 2.5; }
  .chart__point--1 circle { fill: var(--gold); stroke: var(--gold); }
  .chart__value { fill: var(--text); font-size: 15px; font-weight: 700; font-family: var(--font-sans, sans-serif); }
  .chart__rank { fill: var(--gold); font-size: 13px; font-weight: 700; letter-spacing: .04em; font-family: var(--font-sans, sans-serif); }
  .chart__name { fill: var(--text-dim); font-size: 13px; font-family: var(--font-sans, sans-serif); }

  @media (max-width: 640px) {
    .seg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; }
    .seg [role="tab"] { padding: 8px 6px; font-size: 12px; line-height: 1.25; text-align: center; }
    .chart__value { font-size: 20px; }
    .chart__rank { font-size: 18px; }
    .chart__name { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .chart { animation: none; } }
</style>
