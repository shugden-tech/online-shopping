---
import { ClientRouter, fade } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottleSprite from "../components/BottleSprite.astro";
import type { CartDrawerProps } from "../islands/CartDrawer";
import settings from "../data/settings.json";
import { getDict, route, alternatesFor, type Locale } from "../i18n";
import headFont from "../assets/fonts/cormorant-garamond-300-normal.woff2?url";
import sansFontMn from "../assets/fonts/montserrat-400-normal.woff2?url";
import sansFontEn from "../assets/fonts/montserrat-300-normal.woff2?url";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Header starts transparent over a full-bleed hero. */
  overlayHeader?: boolean;
  /** Which nav item is current. */
  current?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "product";
  /** Hide the footer (full-screen experiences like the quiz). */
  bare?: boolean;
  /** Override the mn/en twin paths (defaults to the route table). */
  alternates?: Record<Locale, string>;
}

const {
  locale, title, description, overlayHeader = false, current, noindex = false,
  ogImage = "/og.jpg", ogType = "website", bare = false,
} = Astro.props;
const tr = getDict(locale);
const site = Astro.site ?? new URL("https://genzst.mn");
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/";
const alternates = Astro.props.alternates ?? alternatesFor(path) ?? { mn: route("home", "mn"), en: route("home", "en") };
const hasTwin = Boolean(Astro.props.alternates ?? alternatesFor(path));
const canonical = new URL(path, site).href;
const fullTitle = title === tr.site.name ? tr.site.titleSuffix : `${title} · ${tr.site.titleSuffix}`;
const desc = description ?? tr.site.description;
const abs = (p: string) => new URL(p, site).href;
const cartProps: CartDrawerProps = {
  locale,
  tr: tr.cart,
  ml: tr.common.ml,
  closeLabel: tr.nav.close,
  shopHref: route("shop", locale),
  checkoutHref: route("checkout", locale),
  productBase: route("shop", locale),
  freeThreshold: settings.delivery.freeThreshold,
};
---
<!doctype html>
<html lang={locale} transition:animate={fade({ duration: "0.3s" })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {hasTwin && (
      <>
        <link rel="alternate" hreflang="mn" href={abs(alternates.mn)} />
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.mn)} />
      </>
    )}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={headFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={locale === "mn" ? sansFontMn : sansFontEn} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content="genzst" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:locale" content={locale === "mn" ? "mn_MN" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "mn" ? "en_US" : "mn_MN"} />
    <meta name="twitter:card" content="summary_large_image" />

    <noscript><style>[data-reveal],.ls__card{opacity:1!important;transform:none!important}.hero__content>*,.hero__spot,.hero__scroll{animation:none!important}</style></noscript>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{tr.nav.skip}</a>
    <BottleSprite />
    <Header locale={locale} alternates={alternates} overlay={overlayHeader} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer locale={locale} />}
    <div id="cart-root" data-props={JSON.stringify(cartProps)}></div>
    <script>
      import "../scripts/shell";
    </script>
  </body>
</html>
