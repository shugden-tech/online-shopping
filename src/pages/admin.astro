---
// Owner admin: orders (status changes) and inventory overrides. Static shell; every action calls
// /api/admin/* with the bearer token, which is kept only in this tab's sessionStorage.
// Not linked anywhere, noindex, and excluded from the sitemap (astro.config.mjs).
import "../styles/global.css";
---
<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>genzst admin</title>
    <link rel="icon" href="/favicon.png" />
  </head>
  <body>
    <main class="adm">
      <header class="adm__head">
        <h1 class="t-title">genzst · admin</h1>
        <button type="button" class="btn btn--sm" data-logout hidden>Log out</button>
      </header>

      <form class="adm__login" data-login>
        <div class="field">
          <label for="adm-token">Admin token</label>
          <input class="input" id="adm-token" name="token" type="password" autocomplete="current-password" required />
        </div>
        <button class="btn btn--gold btn--sm" type="submit">Sign in</button>
        <p class="field-error" data-login-err role="alert"></p>
      </form>

      <div data-app hidden>
        <nav class="adm__tabs" role="tablist">
          <button type="button" class="chip" role="tab" data-tab="orders" aria-selected="true">Orders</button>
          <button type="button" class="chip" role="tab" data-tab="inventory" aria-selected="false">Inventory</button>
        </nav>

        <section data-panel="orders">
          <div class="adm__bar">
            <label class="adm__inline">Status
              <select class="select" data-status-filter>
                <option value="">all</option>
                <option>new</option><option>confirmed</option><option>paid</option>
                <option>shipped</option><option>done</option><option>cancelled</option>
              </select>
            </label>
            <button type="button" class="btn btn--sm" data-reload>Refresh</button>
            <p class="t-small t-dim" data-msg role="status"></p>
          </div>
          <div class="adm__scroll">
            <table class="adm__table">
              <thead>
                <tr><th>Order</th><th>Created (UTC)</th><th>Status</th><th>Customer</th><th>Items</th><th>Total ₮</th><th>Change status</th></tr>
              </thead>
              <tbody data-orders></tbody>
            </table>
          </div>
          <button type="button" class="btn btn--sm" data-more hidden>Load more</button>
        </section>

        <section data-panel="inventory" hidden>
          <p class="t-small t-dim">
            A saved price or stock overrides the product file for orders. Empty = use the product file value.
            Stock set here is decremented on each order and restored when an order is cancelled.
            The static storefront still shows the product file's values until the next build.
          </p>
          <div class="adm__bar">
            <input class="input" type="search" placeholder="Filter by brand / name / slug" data-inv-filter />
            <label class="adm__inline"><input type="checkbox" data-inv-only /> overrides only</label>
            <p class="t-small t-dim" data-inv-msg role="status"></p>
          </div>
          <div class="adm__scroll">
            <table class="adm__table">
              <thead>
                <tr><th>Product</th><th>ml</th><th>File price / stock</th><th>Price ₮</th><th>Stock</th><th></th></tr>
              </thead>
              <tbody data-inv></tbody>
            </table>
          </div>
        </section>
      </div>
    </main>

    <style is:global>
      .adm { max-width: 1320px; margin: 0 auto; padding: 24px var(--gutter) 64px; display: grid; gap: 20px; width: 100%; }
      .adm__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 12px; }
      .adm__login { display: grid; gap: 12px; max-width: 360px; }
      .adm__tabs { display: flex; gap: 8px; margin-bottom: 16px; }
      .adm__tabs [aria-selected="true"] { border-color: var(--black); }
      .adm__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 12px; }
      .adm__bar .input { max-width: 320px; }
      .adm__inline { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; }
      .adm__inline .select { width: auto; }
      .adm__scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }
      .adm__table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .adm__table th, .adm__table td { padding: 8px 10px; border-bottom: 1px solid var(--line-soft); text-align: left; vertical-align: top; }
      .adm__table th { font-weight: 500; color: var(--text-dim); background: var(--soft); white-space: nowrap; }
      .adm__table td .input, .adm__table td .select { min-height: 36px; padding: 4px 8px; font-size: 13px; }
      .adm__table td .input { width: 110px; }
      .adm__cell { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
      .adm__mono { font-variant-numeric: tabular-nums; white-space: nowrap; }
      .adm__dim { color: var(--text-dim); }
      .adm__status { display: inline-block; padding: 2px 8px; border: 1px solid var(--line); border-radius: 999px; white-space: nowrap; }
      .adm__status[data-s="cancelled"] { color: var(--danger-text); border-color: var(--danger); }
      .adm__status[data-s="done"] { color: var(--gold-soft); }
    </style>

    <script>
      const SLOT = "gz-admin-token";
      const NEXT: Record<string, string[]> = {
        new: ["confirmed", "cancelled"],
        confirmed: ["paid", "cancelled"],
        paid: ["shipped", "cancelled"],
        shipped: ["done", "cancelled"],
        done: ["cancelled"],
        cancelled: [],
      };

      const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
      const esc = (v: unknown) =>
        String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
      const fmt = (n: number) => new Intl.NumberFormat("en-US").format(n);

      let token = "";
      try { token = sessionStorage.getItem(SLOT) ?? ""; } catch { /* storage blocked */ }

      async function api(path: string, init: RequestInit = {}): Promise<{ status: number; data: any }> {
        const res = await fetch(path, {
          ...init,
          cache: "no-store",
          headers: { ...(init.body ? { "Content-Type": "application/json" } : {}), Authorization: `Bearer ${token}` },
        });
        let data: any = {};
        try { data = await res.json(); } catch { /* empty */ }
        if (res.status === 401) logout("Token rejected.");
        return { status: res.status, data };
      }

      function logout(msg = "") {
        token = "";
        try { sessionStorage.removeItem(SLOT); } catch { /* ignore */ }
        $("[data-app]").hidden = true;
        $("[data-logout]").hidden = true;
        $("[data-login]").hidden = false;
        $("[data-login-err]").textContent = msg;
      }

      /* ---------- orders ---------- */
      let cursor: number | null = null;

      async function loadOrders(reset: boolean) {
        if (reset) { cursor = null; $("[data-orders]").innerHTML = ""; }
        const status = $<HTMLSelectElement>("[data-status-filter]").value;
        const q = new URLSearchParams({ limit: "50" });
        if (status) q.set("status", status);
        if (cursor) q.set("cursor", String(cursor));
        $("[data-msg]").textContent = "Loading…";
        const { status: code, data } = await api(`/api/admin/orders?${q}`);
        if (code !== 200) { $("[data-msg]").textContent = `Error ${code}`; return; }
        $("[data-orders]").insertAdjacentHTML("beforeend", data.orders.map(orderRow).join(""));
        cursor = data.nextCursor;
        $("[data-more]").hidden = !cursor;
        $("[data-msg]").textContent = `${$("[data-orders]").children.length} shown`;
      }

      function orderRow(o: any): string {
        const items = (o.items as any[]).map((i) => `${esc(i.brand)} ${esc(i.name)} ${i.ml}ml ×${i.qty}`).join("<br>");
        const next = NEXT[o.status] ?? [];
        const where = [o.city === "ub" ? "UB" : "Countryside", o.district, o.khoroo].filter(Boolean).map(esc).join(", ");
        return `<tr data-no="${esc(o.order_no)}">
          <td class="adm__mono">${esc(o.order_no)}<br><span class="adm__dim">${esc(o.payment)} · ${esc(o.locale)}</span></td>
          <td class="adm__mono">${esc(o.created_at)}</td>
          <td><span class="adm__status" data-s="${esc(o.status)}">${esc(o.status)}</span></td>
          <td>${esc(o.name)}<br><span class="adm__mono">${esc(o.phone)}${o.phone2 ? " / " + esc(o.phone2) : ""}</span><br>
            <span class="adm__dim">${where}<br>${esc(o.address)}${o.note ? "<br>“" + esc(o.note) + "”" : ""}</span></td>
          <td>${items}</td>
          <td class="adm__mono">${fmt(o.total)}<br><span class="adm__dim">del. ${fmt(o.delivery)}</span></td>
          <td>${next.length ? `<div class="adm__cell">
              <select class="select" data-next>${next.map((s) => `<option>${s}</option>`).join("")}</select>
              <input class="input" data-note placeholder="note (optional)" maxlength="300" />
              <button type="button" class="btn btn--sm" data-apply>Apply</button></div>` : '<span class="adm__dim">final</span>'}</td>
        </tr>`;
      }

      $("[data-orders]").addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-apply]");
        if (!btn) return;
        const tr = btn.closest<HTMLTableRowElement>("tr")!;
        const to = tr.querySelector<HTMLSelectElement>("[data-next]")!.value;
        const note = tr.querySelector<HTMLInputElement>("[data-note]")!.value;
        if (to === "cancelled" && !confirm(`Cancel ${tr.dataset.no}? Tracked stock will be restored.`)) return;
        btn.disabled = true;
        const { status, data } = await api(`/api/admin/orders/${encodeURIComponent(tr.dataset.no!)}`, {
          method: "PATCH",
          body: JSON.stringify({ status: to, note }),
        });
        if (status === 200 && data.order) {
          tr.outerHTML = orderRow(data.order);
          $("[data-msg]").textContent = `${data.order.order_no} → ${data.order.status}${data.restored ? ` (stock restored on ${data.restored} line(s))` : ""}`;
        } else {
          btn.disabled = false;
          $("[data-msg]").textContent = `Error ${status}: ${JSON.stringify(data.errors ?? {})}`;
        }
      });

      /* ---------- inventory ---------- */
      let inventory: any[] = [];

      async function loadInventory() {
        $("[data-inv-msg]").textContent = "Loading…";
        const { status, data } = await api("/api/admin/inventory");
        if (status !== 200) { $("[data-inv-msg]").textContent = `Error ${status}`; return; }
        inventory = data.items;
        renderInventory();
      }

      function renderInventory() {
        const f = $<HTMLInputElement>("[data-inv-filter]").value.trim().toLowerCase();
        const only = $<HTMLInputElement>("[data-inv-only]").checked;
        const rows = inventory.filter(
          (r) => (!only || r.override) && (!f || `${r.brand} ${r.name} ${r.product_id}`.toLowerCase().includes(f)),
        );
        $("[data-inv]").innerHTML = rows.slice(0, 300).map((r) => `<tr data-id="${esc(r.product_id)}" data-ml="${r.ml}">
            <td>${esc(r.brand)} — ${esc(r.name)}<br><span class="adm__dim adm__mono">${esc(r.product_id)}</span></td>
            <td class="adm__mono">${r.ml}</td>
            <td class="adm__mono adm__dim">${fmt(r.json.price)} / ${r.json.stock ?? (r.json.inStock ? "in stock" : "sold out")}</td>
            <td><input class="input" data-price inputmode="numeric" value="${r.override?.price ?? ""}" placeholder="${r.json.price}" /></td>
            <td><input class="input" data-stock inputmode="numeric" value="${r.override?.stock ?? ""}" placeholder="file value" /></td>
            <td><div class="adm__cell"><button type="button" class="btn btn--sm" data-save>Save</button>
              ${r.override ? '<button type="button" class="btn btn--sm btn--ghost" data-remove>Remove override</button>' : ""}</div></td>
          </tr>`).join("");
        $("[data-inv-msg]").textContent = `${rows.length} sizes${rows.length > 300 ? " (first 300 shown; filter to narrow)" : ""} · ${inventory.filter((r) => r.override).length} overrides`;
      }

      const numOrNull = (v: string): number | null | "bad" => {
        const t = v.trim();
        if (!t) return null;
        return /^\d+$/.test(t) ? Number(t) : "bad";
      };

      $("[data-inv]").addEventListener("click", async (e) => {
        const el = e.target as HTMLElement;
        const tr = el.closest<HTMLTableRowElement>("tr");
        if (!tr) return;
        const product_id = tr.dataset.id!;
        const ml = Number(tr.dataset.ml);
        if (el.closest("[data-save]")) {
          const price = numOrNull(tr.querySelector<HTMLInputElement>("[data-price]")!.value);
          const stock = numOrNull(tr.querySelector<HTMLInputElement>("[data-stock]")!.value);
          if (price === "bad" || stock === "bad") { $("[data-inv-msg]").textContent = "Price and stock must be whole numbers (or empty)."; return; }
          const { status, data } = await api("/api/admin/inventory", { method: "PUT", body: JSON.stringify({ product_id, ml, price, stock }) });
          $("[data-inv-msg]").textContent = status === 200 ? `Saved ${product_id} ${ml}ml` : `Error ${status}: ${JSON.stringify(data.errors ?? {})}`;
          if (status === 200) await loadInventory();
        } else if (el.closest("[data-remove]")) {
          const { status } = await api(`/api/admin/inventory?${new URLSearchParams({ product_id, ml: String(ml) })}`, { method: "DELETE" });
          $("[data-inv-msg]").textContent = status === 200 ? `Removed override ${product_id} ${ml}ml` : `Error ${status}`;
          if (status === 200) await loadInventory();
        }
      });
      $("[data-inv-filter]").addEventListener("input", renderInventory);
      $("[data-inv-only]").addEventListener("change", renderInventory);

      /* ---------- shell ---------- */
      function showTab(name: string) {
        document.querySelectorAll<HTMLElement>("[data-tab]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.tab === name)));
        document.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== name));
        if (name === "inventory" && !inventory.length) loadInventory();
      }
      document.querySelectorAll<HTMLElement>("[data-tab]").forEach((b) => b.addEventListener("click", () => showTab(b.dataset.tab!)));

      async function start() {
        const { status } = await api("/api/admin/orders?limit=1");
        if (status !== 200) {
          if (status !== 401) logout(status === 503 ? "Admin is disabled: ADMIN_TOKEN is not set on the server." : `Error ${status}`);
          return;
        }
        try { sessionStorage.setItem(SLOT, token); } catch { /* ignore */ }
        $("[data-login]").hidden = true;
        $("[data-app]").hidden = false;
        $("[data-logout]").hidden = false;
        loadOrders(true);
      }

      $("[data-login]").addEventListener("submit", (e) => {
        e.preventDefault();
        token = $<HTMLInputElement>("#adm-token").value.trim();
        $<HTMLInputElement>("#adm-token").value = "";
        start();
      });
      $("[data-logout]").addEventListener("click", () => logout());
      $("[data-status-filter]").addEventListener("change", () => loadOrders(true));
      $("[data-reload]").addEventListener("click", () => loadOrders(true));
      $("[data-more]").addEventListener("click", () => loadOrders(false));
      if (token) start();
    </script>
  </body>
</html>
