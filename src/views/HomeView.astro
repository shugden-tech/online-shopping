---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import BottleArt from "../components/BottleArt.astro";
import ProductCard from "../components/ProductCard.astro";
import TopCustomers from "../components/TopCustomers.astro";
import Reviews from "../components/Reviews.astro";
import Icon from "../components/Icon.astro";
import settings from "../data/settings.json";
import bestsellerSlugs from "../data/bestsellers.json";
import { getDict, route, fill, type Locale } from "../i18n";
import { formatPrice } from "../lib/price";
import { NOTES, NOTE_GROUPS, getProducts, initialOf, type Product } from "../lib/products";
import { bannerImages, brandLogos, familyStrips, genderImages, noteImages } from "../lib/images";
import allNotesImg from "../../assets/families/all_notes.jpg";
import "../styles/home.css";

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = getDict(locale);
const s = tr.store;
const shop = route("shop", locale);
const free = formatPrice(settings.delivery.freeThreshold, locale);
const products = await getProducts();
const bestsellers = bestsellerSlugs.map((slug) => {
  const product = products.find((p) => p.slug === slug);
  if (!product) throw new Error(`Unknown bestseller product: ${slug}`);
  return product;
});

const byFeatured = [...products].sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false) || Number(b.isNew ?? false) - Number(a.isNew ?? false),
);
const fresh = [...products].sort((a, b) => Number(b.isNew ?? false) - Number(a.isNew ?? false));
const ofGender = (g: Product["gender"]) => byFeatured.filter((p) => p.gender === g);

const tabs = [
  { id: "best", label: s.tabs.best, items: bestsellers, href: shop },
  { id: "new", label: s.tabs.new, items: fresh.slice(0, 8), href: `${shop}?sort=newest` },
  { id: "women", label: s.tabs.women, items: ofGender("women").slice(0, 8), href: `${shop}?gender=women` },
  { id: "men", label: s.tabs.men, items: ofGender("men").slice(0, 8), href: `${shop}?gender=men` },
  { id: "unisex", label: s.tabs.unisex, items: ofGender("unisex").slice(0, 8), href: `${shop}?gender=unisex` },
].filter((t) => t.items.length > 0);

/** Three bottles with different liquid colours for a banner. */
const trio = (list: Product[]) => list.filter((p, i) => list.findIndex((o) => o.family === p.family) === i).slice(0, 3);

const slides = [
  { ...s.slides[0]!, href: shop, img: familyStrips.amber!, bg: "#2b211b,#8a5a33", bottles: trio(byFeatured) },
  { ...s.slides[1]!, href: `${shop}?sort=newest`, img: familyStrips.citrus!, bg: "#1d3433,#5f8f86", bottles: trio(fresh) },
  { ...s.slides[2]!, href: route("finder", locale), img: familyStrips.woody!, bg: "#2a2233,#6b5f70", bottles: trio([...byFeatured].reverse()) },
];

// Owner's banner pictures (src/assets/thumbnail/) replace the illustrated slides when present.
// Files named "mobile …" are the tall phone versions; the rest are the wide desktop ones.
const deskBanners = bannerImages.filter((b) => !/^mobile/i.test(b.name));
const mobBanners = bannerImages.filter((b) => /^mobile/i.test(b.name));
const bannerSets = [
  { key: "desk", items: deskBanners.length ? deskBanners : mobBanners, only: mobBanners.length && deskBanners.length ? "hb--desk" : "" },
  { key: "mob", items: deskBanners.length && mobBanners.length ? mobBanners : [], only: "hb--mob" },
].filter((set) => set.items.length > 0);
const ratio = (b: (typeof bannerImages)[number]) => `${b.image.width} / ${b.image.height}`;

/** Gender tiles: owner-approved images, ordered Unisex / Men / Women. */
const genderTiles = (["unisex", "men", "women"] as const).map((g) => ({
  g, label: tr.genders[g], href: `${shop}?gender=${g}`,
  image: genderImages[g]!,
}));

const infoIcons = ["bag", "check", "briefcase"] as const;
---
<Base locale={locale} title={tr.site.name}>
  <!-- 1 · banner slider: the owner's pictures (desktop + phone sets), else the illustrated slides -->
  {bannerSets.length > 0 && <h1 class="sr-only">{s.slides[0]!.title}</h1>}
  {bannerSets.map((set) => (
    <section class:list={["wrap hb", set.only]} aria-roledescription="carousel" aria-label={tr.home.slider.label} data-slider>
      <div class="hb__track hb__track--img" style={`aspect-ratio:${ratio(set.items[0]!)}`}>
        {set.items.map((b, i) => (
          <div class:list={["hb__slide hb__slide--img", { "is-on": i === 0 }]} data-slide aria-roledescription="slide" aria-label={`${i + 1} / ${set.items.length}`} aria-hidden={i === 0 ? undefined : "true"}>
            <a class="hb__link" href={shop} tabindex={i === 0 ? undefined : -1}>
              <Image
                src={b.image} alt={`${tr.site.name} — ${i + 1}`}
                widths={set.key === "mob" ? [480, 760, 1145] : [640, 960, 1320, 1852]}
                sizes={set.key === "mob" ? "100vw" : "(min-width: 1320px) 1320px, 100vw"}
                loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} class="hb__img"
              />
            </a>
          </div>
        ))}
      </div>
      <button class="hb__arrow hb__arrow--prev" type="button" data-prev aria-label={tr.common.prev}><Icon name="chevron" size={22} /></button>
      <button class="hb__arrow hb__arrow--next" type="button" data-next aria-label={tr.common.next}><Icon name="chevron" size={22} /></button>
      <div class="hb__dots">
        {set.items.map((_, i) => (
          <button type="button" data-dot={i} aria-label={`${i + 1} / ${set.items.length}`} aria-current={i === 0 ? "true" : undefined}></button>
        ))}
      </div>
    </section>
  ))}

  {bannerSets.length === 0 && (
    <section class="wrap hb" aria-roledescription="carousel" aria-label={tr.home.slider.label} data-slider>
      <div class="hb__track">
        {slides.map((sl, i) => (
          <div class:list={["hb__slide", { "is-on": i === 0 }]} data-slide style={`--a:${sl.bg.split(",")[0]};--b:${sl.bg.split(",")[1]}`} aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`} aria-hidden={i === 0 ? undefined : "true"}>
            <Image src={sl.img} alt="" widths={[640, 1280, 1920]} sizes="(min-width: 1320px) 1320px, 100vw" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} class="hb__bg" />
            <div class="hb__text">
              <p class="hb__eyebrow">{sl.eyebrow}</p>
              {i === 0 ? <h1 class="hb__title">{sl.title}</h1> : <h2 class="hb__title">{sl.title}</h2>}
              <p class="hb__sub">{sl.text}</p>
              <a class="btn btn--light" href={sl.href} tabindex={i === 0 ? undefined : -1}>{sl.cta}</a>
            </div>
            <div class="hb__bottles" aria-hidden="true">
              {sl.bottles.map((p) => (
                <div class="hb__bottle"><BottleArt shape={p.bottleShape} family={p.family} initial={initialOf(p)} image={p.image} /></div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <button class="hb__arrow hb__arrow--prev" type="button" data-prev aria-label={tr.common.prev}><Icon name="chevron" size={22} /></button>
      <button class="hb__arrow hb__arrow--next" type="button" data-next aria-label={tr.common.next}><Icon name="chevron" size={22} /></button>
      <div class="hb__dots">
        {slides.map((_, i) => (
          <button type="button" data-dot={i} aria-label={`${i + 1} / ${slides.length}`} aria-current={i === 0 ? "true" : undefined}></button>
        ))}
      </div>
    </section>
  )}

  <!-- 2 · two promo tiles -->
  <section class="wrap promo">
    <a class="promo__tile promo__tile--big" href={shop} style="--a:#efe9df;--b:#d9cbb4">
      <Image src={allNotesImg} alt="" widths={[480, 960, 1280]} sizes="(min-width: 900px) 66vw, 100vw" loading="lazy" />
      <span class="promo__label">{s.tileAll}</span>
    </a>
    <a class="promo__tile" href={`${shop}?sort=newest`} style="--a:#e7e3ef;--b:#b9aecb">
      <Image src={familyStrips.fresh!} alt="" widths={[480, 720]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />
      <span class="promo__label">{s.tileNew}</span>
    </a>
  </section>

  <!-- 3 · featured collections (scent notes) -->
  <section class="coll" aria-labelledby="coll-title">
    <div class="wrap">
      <h2 class="h-sec" id="coll-title">{s.collections}</h2>
      <ul class="coll__rail" tabindex="0" aria-labelledby="coll-title">
        {NOTE_GROUPS.map((g) => (
          <li>
            <a class="coll__item" href={`${shop}?notes=${g}`}>
              <span class="coll__img">
                <Image src={noteImages[g]!} alt="" widths={[200, 400]} sizes="180px" loading="lazy" quality={62} />
              </span>
              <span class="coll__name">{NOTES[g]![locale]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · gender tiles -->
  <section class="wrap gtiles">
    {genderTiles.map((t) => (
      <a class={`gtile gtile--${t.g}`} href={t.href}>
        <Image src={t.image} alt="" widths={[400, 800]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" class="gtile__img" />
        <span class="gtile__label">{t.label}</span>
      </a>
    ))}
  </section>

  <!-- 5 · tabbed product grid -->
  <section class="wrap tabs-sec" aria-label={tr.nav.shop} data-tabs>
    <div class="tabs" role="tablist">
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          {t.label}
        </button>
      ))}
    </div>
    {tabs.map((t, i) => (
      <div class="tabs__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
        <ul class="grid">
          {t.items.map((p, j) => (
            <li><ProductCard product={p} locale={locale} level={3} eager={i === 0 && j < 4} /></li>
          ))}
        </ul>
        <div class="tabs__more"><a class="btn" href={t.href}>{s.seeAll} · {t.label}</a></div>
      </div>
    ))}
  </section>

  <!-- 5b · demo community: top customers + reviews -->
  <TopCustomers locale={locale} />
  <Reviews locale={locale} />

  <!-- 6 · brands -->
  <section class="brands" aria-label={tr.nav.shop}>
    <div class="brands__marquee">
      <ul class="brands__track">
        {[...brandLogos, ...brandLogos].map((b, i) => (
          <li aria-hidden={i >= brandLogos.length ? "true" : undefined}>
            <a href={`${shop}?q=${encodeURIComponent(b.name)}`} tabindex={i >= brandLogos.length ? -1 : undefined}>
              <img src={b.src} alt={b.name} width="160" height="64" loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7 · about -->
  <section class="wrap about" aria-labelledby="about-title">
    <h2 class="h-sec" id="about-title">{s.aboutTitle}</h2>
    <p>{s.about1}</p>
    <p>{s.about2}</p>
  </section>

  <!-- 8 · info line -->
  <section class="info">
    <ul class="wrap info__in">
      {s.info.map((it, i) => (
        <li>
          <span class="info__icon"><Icon name={infoIcons[i] ?? "check"} size={26} /></span>
          <span><b>{it.t}</b><span>{fill(it.d, { price: free })}</span></span>
        </li>
      ))}
    </ul>
  </section>

  <script>
    import "../scripts/store-home";
  </script>
</Base>
