---
import Base from "../layouts/Base.astro";
import { getDict, route, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = getDict(locale);

// Strings for the client script (src/scripts/profile.ts). Serialized as JSON with `<` escaped.
const strings = {
  locale,
  shop: route("shop", locale),
  a: tr.account,
  shopLabel: tr.nav.shop,
  ml: tr.common.ml,
  wishEmpty: tr.store.wishEmpty,
  wishEmptySub: tr.store.wishEmptySub,
  err: {
    required: tr.checkout.errors.required,
    name: tr.checkout.errors.name,
    phone: tr.checkout.errors.phone,
    server: tr.checkout.errors.server,
  },
};
---
<Base locale={locale} title={tr.account.title} noindex>
  <section class="wrap page-top profile" data-profile-root></section>
  <script type="application/json" id="profile-i18n" is:inline set:html={JSON.stringify(strings).replace(/</g, "\\u003c")}></script>
  <script>
    import "../scripts/profile";
  </script>
</Base>

<style is:global>
  .profile { max-width: 1040px; padding-block: 48px 96px; }
  .pf-card { max-width: 440px; margin: 32px auto 0; padding: 40px 32px; border: 1px solid var(--line); border-radius: var(--radius); text-align: center; }
  .pf-title { font-size: clamp(28px, 4vw, 38px); margin: 0; }
  .pf-prompt { margin: 12px 0 0; }
  .pf-form { display: grid; gap: 18px; margin-top: 28px; text-align: left; }
  .pf-form .btn { margin-top: 6px; }
  .pf-status { margin: 0; }
  .pf-muted { font-size: 13px; line-height: 1.5; color: var(--text-dim); margin: 0; }
  .pf-card > .pf-muted { margin-top: 24px; }

  .pf-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .pf-demo { margin-top: 12px; }
  .pf-sec { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .pf-sec__body { margin-top: 20px; }

  .pf-orders { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-soft); }
  .pf-order { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line-soft); font-size: 14px; }
  .pf-order__meta { display: grid; gap: 4px; min-width: 0; }
  .pf-order__total { text-align: right; white-space: nowrap; }
  .pf-order__sum { display: flex; justify-content: space-between; gap: 16px; margin: 16px 0 0; font-size: 15px; }

  .pf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: 24px 20px; list-style: none; margin: 0; padding: 0; }
  .pf-card-item { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .pf-card-item__img { width: 100%; aspect-ratio: 1; object-fit: contain; background: var(--soft); border-radius: 6px; }
  .pf-brand { margin: 0; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-dim); }
  .pf-card-item__name { font-size: 14px; line-height: 1.35; color: var(--text); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
  .pf-card-item p { margin: 0; }

  .pf-board { display: grid; gap: 18px; max-width: 480px; }
  .pf-check { display: flex; align-items: center; gap: 12px; min-height: 44px; font-size: 14px; cursor: pointer; }
  .pf-check input { width: 18px; height: 18px; accent-color: var(--black); }
  .pf-saved { min-height: 1.4em; margin: 0; font-size: 13px; color: var(--text-dim); }

  @media (max-width: 560px) {
    .pf-card { padding: 32px 20px; }
    .pf-order { grid-template-columns: minmax(0, 1fr) auto; }
    .pf-order > span:nth-child(2) { grid-column: 1; grid-row: 2; }
    .pf-order__total { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
